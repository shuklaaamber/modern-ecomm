{
  "name": "ecommerceapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx db/seed.ts",
    "test:e2e": "playwright test",
    "db:migrate:test": "node --env-file=.env.test node_modules/drizzle-kit/bin.cjs migrate",
    "test:integration": "node --env-file=.env.test node_modules/vitest/vitest.mjs run tests/integration"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.9.0",
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "razorpay": "^2.9.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.35.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
