# Use the Neon POOLED host (contains "-pooler") for the app. DIRECT_DATABASE_URL (non-pooler) is used by drizzle-kit migrations.
# DIRECT_DATABASE_URL=postgres://user:pass@host/db
# DB_POOL_MAX=3
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
EMAIL_TRANSPORT=console
CRON_SECRET=
# Shared rate limiting (required in production). Empty = per-process memory (dev only).
REDIS_URL=
# Email: console prints receipts; resend sends them (EMAIL_FROM must be a verified Resend sender).
RESEND_API_KEY=
EMAIL_FROM="Thread & Co. <orders@example.com>"
# Logs: shipped to Axiom (required in production). Token needs ingest permission on the dataset.
AXIOM_TOKEN=
AXIOM_DATASET=
# Errors: Sentry DSN (server). NEXT_PUBLIC_SENTRY_DSN is the same DSN for browser errors.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only (CI/deploy secret, never NEXT_PUBLIC): enables Sentry source-map upload.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
